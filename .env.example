# ── Required ──────────────────────────────────────────────────────────────────
# Generate a random 32-character string for JWT signing
SESSION_SECRET=change-me-to-a-random-32-char-string

# Geotab GenAI Gateway API key (or any OpenAI-compatible key)
GENAI_API_KEY=your-api-key-here

# ── AI Gateway ────────────────────────────────────────────────────────────────
# Override to point at the Geotab GenAI Gateway
GENAI_GATEWAY_URL=https://genai-us.geotab.com/api/v2
GENAI_MODEL=gemini-2.5-flash-lite

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
JWT_EXPIRE_HOURS=4
JOB_TTL_HOURS=2
SAFETY_HIGH_RISK=60.0
SAFETY_MEDIUM_RISK=75.0
DORMANT_DAYS_THRESHOLD=5
